	)
	(text_box "To connect the channel B, shorten pulser outputs PULSER_OUT_B and PULSER_OUT_A. Moreover, remove resistor that pulls PULSER_IN_B to ground and connect this line to PULSER_IN_A. Connect PULSER_EN_A to PULSER_EN_B"
		(exclude_from_sim no)
		(at 180.34 117.2972 0)
		(size -64.77 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
